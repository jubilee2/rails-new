<h2>Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |form| %>
  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :password %><br>
    <%= form.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div>
      <%= form.check_box :remember_me %>
      <%= form.label :remember_me %>
    </div>
  <% end %>

  <div>
    <%= form.submit "Log in" %>
  </div>
<% end %>
